# redstone_counter.bd - Redstone Pulse Counter in Bedrock (.bd)

var signal_strength = 0
var max_signal = 15

print "Starting Redstone Clock..."

while signal_strength <= max_signal {
    print "Redstone Wire Signal: " + signal_strength
    if signal_strength == 15 {
        say "Redstone Lamp Powered On!"
    }
    signal_strength = signal_strength + 3
}

print "Redstone cycle finished."
